---
/**
 * The single page. Reframed as an editorial front page with dedicated anchor sections for
 * Myths, History, Leadership, and About, while keeping the project within its current
 * single-page static-site scope.
 */
import Base from "../layouts/Base.astro";
import SEO from "../components/SEO.astro";
import "../data/guards";
import profile from "../data/profile";
import principles from "../data/principles";
import evidence from "../data/evidence";
import philosophy, { connectiveLine } from "../data/philosophy";
import {
  aboutSection,
  contentPillars,
  contactLabels,
  editorialStructure,
  historySection,
  homeHero,
  leadershipDetailLabels,
  leadershipSection,
  mythsSection,
  pillarsOverview,
} from "../data/editorial";

const linkedIn = profile.linkedInUrl;
---

<Base>
  <SEO slot="head" />

  <article>
    <section
      id="home"
      class="section section--flush hero-section"
      aria-labelledby="hero-heading"
    >
      <div class="shell">
        <div class="hero-copy">
          <p class="eyebrow">{homeHero.eyebrow}</p>
          <h1 id="hero-heading">{homeHero.title}</h1>
          <p class="hero-lede measure">{homeHero.intro}</p>

          <div class="hero-actions">
            <a class="cta" href={homeHero.primaryCta.href}
              >{homeHero.primaryCta.label}</a
            >
          </div>
        </div>
      </div>
    </section>

    <section id="pillars" class="section" aria-labelledby="pillars-heading">
      <div class="shell">
        <div class="section-header">
          <p class="eyebrow">{pillarsOverview.eyebrow}</p>
          <h2 id="pillars-heading">{pillarsOverview.title}</h2>
          <p class="measure">{pillarsOverview.intro}</p>
        </div>

        <div class="card-grid card-grid--three">
          {
            contentPillars.map((pillar) => (
              <article class="card card--pillar">
                <h3>{pillar.title}</h3>
                <p>{pillar.description}</p>
                <a class="text-link" href={pillar.href}>
                  {pillar.linkLabel}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="myths" class="section" aria-labelledby="myths-heading">
      <div class="shell">
        <div class="section-header">
          <p class="eyebrow">{mythsSection.eyebrow}</p>
          <h2 id="myths-heading">{mythsSection.title}</h2>
          <p class="measure">{mythsSection.intro}</p>
        </div>

        <div class="card-grid card-grid--three">
          {
            mythsSection.cards.map((card) => (
              <article class="card">
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <a class="text-link" href={card.href}>
                  {card.linkLabel}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="history" class="section" aria-labelledby="history-heading">
      <div class="shell">
        <div class="section-header">
          <p class="eyebrow">{historySection.eyebrow}</p>
          <h2 id="history-heading">{historySection.title}</h2>
          <p class="measure">{historySection.intro}</p>
        </div>

        <div class="card-grid card-grid--three">
          {
            historySection.cards.map((card) => (
              <article class="card">
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <a class="text-link" href={card.href}>
                  {card.linkLabel}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="leadership"
      class="section"
      aria-labelledby="leadership-heading"
    >
      <div class="shell">
        <div class="section-header">
          <p class="eyebrow">{leadershipSection.eyebrow}</p>
          <h2 id="leadership-heading">{leadershipSection.title}</h2>
          <p class="measure">{leadershipSection.intro}</p>
        </div>

        <div class="card-grid">
          {
            leadershipSection.cards.map((card) => (
              <article class="card">
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <a class="text-link" href={card.href}>
                  {card.linkLabel}
                </a>
              </article>
            ))
          }
        </div>

        <div class="leadership-layout">
          <article id="leadership-principles" class="card card--stack">
            <p class="eyebrow">{leadershipDetailLabels.principlesEyebrow}</p>
            <h3>{leadershipDetailLabels.principlesTitle}</h3>
            <ul class="stack-list" role="list">
              {
                principles.map((principle) => (
                  <li>
                    <h4>{principle.title}</h4>
                    <p>{principle.body}</p>
                  </li>
                ))
              }
            </ul>
          </article>

          <article id="leadership-philosophy" class="card card--stack">
            <p class="eyebrow">{leadershipDetailLabels.philosophyEyebrow}</p>
            <h3>{leadershipDetailLabels.philosophyTitle}</h3>
            <dl class="pillars-list">
              {
                philosophy.map((pillar) => (
                  <div>
                    <dt>{pillar.label}</dt>
                    <dd>{pillar.body}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="connective">{connectiveLine}</p>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="shell about-layout">
        <div>
          <div class="section-header">
            <p class="eyebrow">{aboutSection.eyebrow}</p>
            <h2 id="about-heading">{aboutSection.title}</h2>
            <p class="measure">{aboutSection.intro}</p>
          </div>

          <div class="card-grid">
            {
              aboutSection.cards.map((card) => (
                <article class="card">
                  <h3>{card.title}</h3>
                  <p>{card.description}</p>
                  <a class="text-link" href={card.href}>
                    {card.linkLabel}
                  </a>
                </article>
              ))
            }
          </div>
        </div>

        <aside class="card card--stack about-aside">
          <p class="eyebrow">{profile.roleLine.text}</p>
          <h3>{profile.positioning.text}</h3>
          <p>{profile.supportingStatement}</p>

          <ul class="stack-list" role="list">
            {
              evidence
                .slice(0, editorialStructure.aboutEvidencePreview)
                .map((item) => (
                  <li>
                    <h4>{item.title}</h4>
                    <p>{item.body}</p>
                  </li>
                ))
            }
          </ul>

          {
            linkedIn ? (
              <a
                class="cta"
                href={linkedIn}
                target="_blank"
                rel="noopener noreferrer"
              >
                {contactLabels.linkedIn}
              </a>
            ) : (
              <span class="cta cta--placeholder">
                {contactLabels.linkedInPlaceholder}
              </span>
            )
          }
        </aside>
      </div>
    </section>
  </article>
</Base>

<style>
  .hero-section {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  :where(section, article)[id] {
    scroll-margin-top: var(--header-offset);
  }

  .about-layout,
  .leadership-layout {
    display: grid;
    gap: var(--space-l);
  }

  .leadership-layout {
    margin-top: var(--space-xl);
  }

  .hero-copy h1 {
    max-width: 11ch;
    font-size: var(--step-5);
  }

  .hero-lede {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .section-header {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-l);
  }

  .section-header p:not(.eyebrow) {
    color: var(--text-muted);
  }

  .card {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background:
      linear-gradient(
        180deg,
        rgb(255 255 255 / 0.04),
        rgb(255 255 255 / 0.015)
      ),
      var(--surface);
  }

  .card p,
  .card dd,
  .stack-list p {
    color: var(--text-muted);
  }

  .card-grid {
    display: grid;
    gap: var(--space-m);
  }

  .card h3 {
    margin-bottom: var(--space-xs);
  }

  .card h4 {
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-m);
    font-weight: 600;
    text-decoration: none;
  }

  .text-link::after {
    content: "→";
  }

  .stack-list {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .stack-list li + li {
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
  }

  .card--stack {
    align-self: start;
  }

  .pillars-list {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .pillars-list dt {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
  }

  .pillars-list dd {
    margin: 0;
  }

  .connective {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
  }

  .about-aside .cta {
    margin-top: var(--space-l);
  }

  @media (min-width: 48rem) {
    .card-grid--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .leadership-layout,
    .about-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }
</style>
