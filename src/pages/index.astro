---
/**
 * The single page. Composes the six sections in the fixed order required by
 * page-contract.md: Hero → The Intersection → How I Think → Evidence →
 * Leadership Philosophy → Closing. No client-side reordering.
 */
import Base from "../layouts/Base.astro";
import SEO from "../components/SEO.astro";
import Hero from "../components/Hero.astro";
import Intersection from "../components/Intersection.astro";
import Principles from "../components/Principles.astro";
import Evidence from "../components/Evidence.astro";
import Philosophy from "../components/Philosophy.astro";
import Closing from "../components/Closing.astro";
import "../data/guards"; // build-time content assertions (T015)
---

<Base>
  <SEO slot="head" />

  <section id="hero" aria-labelledby="hero-heading">
    <Hero />
  </section>

  <section id="intersection" aria-labelledby="intersection-heading">
    <Intersection />
  </section>

  <section id="how-i-think" aria-labelledby="how-i-think-heading">
    <Principles />
  </section>

  <section id="evidence" aria-labelledby="evidence-heading">
    <Evidence />
  </section>

  <section id="philosophy" aria-labelledby="philosophy-heading">
    <Philosophy />
  </section>

  <section id="closing" aria-labelledby="closing-heading">
    <Closing />
  </section>
</Base>
