---
/**
 * The Intersection's system diagram (FR-005, FR-027). Inline SVG, data-driven from
 * `disciplines.ts`. `role="img"` + `aria-labelledby` reference a `<title>` and `<desc>`;
 * the `<desc>` is `diagramAltText` verbatim so the text alternative cannot drift.
 *
 * Layout: Systems is the hub at the centre; the other four sit in a diamond around it, so
 * the spokes (Systems ↔ each) and the ring (each ↔ its neighbours) both read cleanly.
 *
 * The default state is the finished, legible diagram — no JavaScript. A subtle one-time
 * fade (FR-005a) is layered on in CSS only, via a `view()` scroll timeline guarded by
 * `@supports` and `prefers-reduced-motion`; unsupported or reduced-motion readers get the
 * final diagram with no motion. Below ~480px the SVG is swapped (CSS only) for a stacked
 * text layout carrying the same five nodes.
 */
import disciplines, { diagramAltText } from "../data/disciplines";

const W = 400;
const H = 300;
const cx = W / 2;
const cy = H / 2;

// Systems at the centre; the other four in a diamond (top, right, bottom, left) in an
// order that keeps the ring edges along the perimeter rather than crossing the middle.
const HUB = "systems";
const RING = ["technology", "people", "delivery", "product"] as const;
const RADIUS = 118;

const coord = new Map<string, { x: number; y: number }>([
  [HUB, { x: cx, y: cy }],
]);
RING.forEach((id, i) => {
  const angle = -Math.PI / 2 + (i * Math.PI) / 2;
  coord.set(id, {
    x: +(cx + RADIUS * Math.cos(angle)).toFixed(1),
    y: +(cy + RADIUS * Math.sin(angle)).toFixed(1),
  });
});

const points = disciplines.map((d) => ({ ...d, ...coord.get(d.id)! }));

// Dedupe undirected edges from `connectsTo`.
const seen = new Set<string>();
const edges: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (const node of disciplines) {
  for (const other of node.connectsTo) {
    const key = [node.id, other].sort().join("~");
    if (seen.has(key)) continue;
    seen.add(key);
    const a = coord.get(node.id)!;
    const b = coord.get(other)!;
    edges.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
  }
}

const titleId = "diagram-title";
const descId = "diagram-desc";
---

<figure class="diagram">
  <svg
    class="diagram-svg"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-labelledby={`${titleId} ${descId}`}
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={titleId}>
      Technology, People, Product, Delivery and Systems as one connected system
    </title>
    <desc id={descId}>{diagramAltText}</desc>

    <g class="edges">
      {edges.map((e) => <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} />)}
    </g>

    <g class="nodes">
      {
        points.map((p) => {
          const leftHalf = p.x < cx - 1;
          const rightHalf = p.x > cx + 1;
          const anchor = leftHalf ? "end" : rightHalf ? "start" : "middle";
          const dx = leftHalf ? -12 : rightHalf ? 12 : 0;
          const dy = p.id === HUB ? 22 : p.y < cy ? -14 : 24;
          return (
            <g>
              <circle cx={p.x} cy={p.y} r={p.id === HUB ? 6 : 5} />
              <text x={p.x + dx} y={p.y + dy} text-anchor={anchor}>
                {p.label}
              </text>
            </g>
          );
        })
      }
    </g>
  </svg>

  <ul class="diagram-stack" role="list" aria-hidden="true">
    {
      points.map((p) => (
        <li>
          <span class="diagram-stack__label">{p.label}</span>
          <span class="diagram-stack__blurb">{p.blurb}</span>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .diagram {
    margin: var(--space-l) auto 0;
    max-width: 34rem;
  }

  .diagram-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .edges line {
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .nodes circle {
    fill: var(--accent);
  }

  .nodes text {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  /*
   * Subtle one-time reveal (FR-005a) — CSS only. The diagram's resting state is complete;
   * this fades it in once as it scrolls up into view. `animation-range: entry …` means a
   * figure already on screen at load is past the range and simply shown finished (no
   * flash), and a browser without `view()` timelines or with reduced motion ignores it.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .diagram-svg {
        animation: diagram-in linear both;
        animation-timeline: view();
        animation-range: entry 20% entry 95%;
      }
    }
  }

  @keyframes diagram-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Stacked fallback for narrow viewports. */
  .diagram-stack {
    display: none;
  }

  @media (max-width: 30rem) {
    /*
     * Narrow viewports: hide the SVG visually but keep it in the accessibility tree so
     * `<title>`/`<desc>` still carry the relationship (FR-027). Sighted users get the
     * legible stacked layout below; it is `aria-hidden` so AT hears the diagram once.
     */
    .diagram-svg {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .diagram-stack {
      display: grid;
      gap: var(--space-s);
      margin-top: var(--space-m);
    }

    .diagram-stack li {
      display: grid;
      gap: 0.15rem;
      padding-left: var(--space-s);
      border-left: 2px solid var(--accent);
    }

    .diagram-stack__label {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text);
    }

    .diagram-stack__blurb {
      color: var(--text-muted);
      font-size: var(--step--1);
    }
  }
</style>
